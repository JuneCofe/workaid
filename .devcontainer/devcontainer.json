{
  "name": "WorkAid",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "forwardPorts": [8081, 5173],
  "portsAttributes": {
    "8081": { "label": "API", "onAutoForward": "notify" },
    "5173": { "label": "Web", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "pip install -e \".[dev]\" && npm install && cp -n .env.example .env || true",
  "postStartCommand": "(python agent.py &) && npm run dev -- --host 0.0.0.0",
  "customizations": {
    "vscode": { "extensions": ["ms-python.python", "dbaeedt.vscode-json-format"] }
  }
}
