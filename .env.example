# WorkAid 环境变量示例
# 复制为 .env 后按需修改；真实密钥只放在本机 .env 或部署环境中，不要提交到版本库。
# 可配置存储路径支持绝对路径；相对路径均以 WorkAid 项目根目录为基准。

# 应用服务
# 本地服务监听端口。
PORT=8081
# 开发时设为 1 启用 Uvicorn 热重载；部署环境建议保持 0。
WORKAID_RELOAD=0

# 本地存储与长期记忆
# SQLite 数据库：保存对话记录、短期对话上下文和用户长期画像。
DATABASE_PATH=data/workaid.sqlite3
# 用户可维护的长期画像/偏好通过应用写入数据库；此处无需单独配置。

# 本地知识库
# WorkAid 自带法规知识库：语料位于 rag/data，SQLite/FTS 索引位于 rag/cache。
# 两者均随项目目录维护，无需依赖其他项目路径。
# WorkAid 本地案例目录，JSONL 格式；本地无命中后才查询远端兜底来源。
CASE_CATALOG_PATH=data/cases.jsonl

# 大语言模型（可选）
# OpenAI 兼容服务的 API Key。留空时使用本地确定性意图路由及回答降级逻辑。
OPENAI_API_KEY=
# 可选：OpenAI 兼容 API 的基础地址；使用官方 OpenAI API 时留空。
OPENAI_BASE_URL=
# 对话模型名称；请确认所用服务支持该模型。
OPENAI_MODEL=gpt-4o-mini
# 可选：随每次请求发送的 JSON，用于服务商特有开关。DeepSeek 可设为 {"thinking":{"type":"disabled"}}，
# 关闭推理阶段，首个字可提前约 10 秒。
OPENAI_EXTRA_BODY=

# 华宇元典 MCP（可选的法律检索兜底）
# 在本地法规/案例库无命中时才调用元典。申请和配置方式参考：
# https://open.chineselaw.com/mcp-config
# 将 API Key 原样填写，不要添加 "Bearer " 前缀；程序会自动添加认证头。
# 启用后，当前检索文本会发送至元典，请勿提交身份证号等敏感个人信息。
# 元典语义检索工具按官方目录计费（当前标价 15 POINT/次），启用前请确认账户套餐和余额。
YUANDIAN_MCP_API_KEY=
# 以下默认地址为官方 Streamable HTTP 服务。自定义时仍必须使用官方 HTTPS 主机。
YUANDIAN_LAW_MCP_URL=https://open.chineselaw.com/mcp/law/stream
YUANDIAN_CASE_MCP_URL=https://open.chineselaw.com/mcp/case/stream
# 官方工具名称；通常无需修改。
YUANDIAN_LAW_MCP_TOOL=yuandian_law_vector_search
YUANDIAN_CASE_MCP_TOOL=yuandian_case_vector_search

# 法条检索流水线（改写 -> 多路召回 -> 重排）
# 配置 OPENAI_API_KEY 后，词典认不出的问题会让模型生成书面检索语；设为 always 则每次都调用，0 则完全关闭。
RETRIEVAL_LLM_REWRITE=1
# 可选：改写用的更便宜模型；留空则使用 OPENAI_MODEL。
RETRIEVAL_REWRITE_MODEL=
# 可选：Cohere/Jina/SiliconFlow 风格的 /rerank 接口（必须是 https，或本机 http）。留空则只用内置特征打分。
# 启用后，用户的案情文本会发送到该服务，请勿传入敏感个人信息。超时或出错自动降级。
RERANK_API_URL=
RERANK_API_KEY=
RERANK_MODEL=
RERANK_TIMEOUT=3
# 接口分数在最终排序中的占比（0-1）。在现有 45 条人工标注上，占比越高 top1 越差（0.7 时 MRR 0.60，关闭时 0.78），默认 0.15；
# 换新标注集后请重新用 eval/run_statute_eval.py 校准。相关度门槛始终由内置打分决定，接口不能放宽门槛。
RERANK_BLEND=0.15
# 相关度门槛（0-1）：低于门槛视为本地未命中。一般无需修改，调整前请先跑 eval/run_statute_eval.py。
RETRIEVAL_MIN_SCORE=0.28
RETRIEVAL_MIN_SCORE_OPEN=0.6
RETRIEVAL_MIN_SCORE_API=0.2

# 向量召回（语义检索）
# 默认使用硅基流动（SiliconFlow）托管的 BAAI/bge-m3：中文法律文本效果好、支持长文本，价格低；
# 全库约 3.5 万条全国性法律法规约 300 万 token，按其公开价格属于几元量级（以官方当前价格为准）。
# 其他 OpenAI 兼容的 embedding 服务（含本机 Ollama/vLLM）只需改下面三项。
# 在此填入密钥后运行：python -I scripts/build_vector_index.py（先加 --dry-run 可只估算规模）。
EMBEDDING_API_KEY=
EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
EMBEDDING_MODEL=BAAI/bge-m3
# 更换模型后必须重建索引；索引与模型名绑定，不匹配时自动停用向量路。
# 启用后用户的案情文本会发送到该服务，请勿传入敏感个人信息。
# 向量索引覆盖的语料类别（逗号分隔）；地方性法规默认不建向量索引。
VECTOR_CATEGORIES=法律,行政法规,司法解释,部门规章
VECTOR_MIN_COSINE=0.35

# 启动预热：服务启动后在后台加载检索引擎和向量索引，设为 0 关闭。
WORKAID_WARMUP=1

# 本地案例库
# data/cases.jsonl 由 scripts/import_cases.py 写入，不要手工编辑。
# 设为 1 时只返回"已核验"的案例（需要你或律师对照官方原文核对后在案例里标记已核验）。
CASE_ONLY_REVIEWED=0
# 本地案例相关度门槛（0-1），低于门槛视为未命中并转入元典兜底。
CASE_MIN_SCORE=0.45
# 本实例对外提供案例检索接口 POST /api/cases/search 的密钥；留空则该接口关闭（返回 404）。
# 用途见 README "案例检索 REST 兜底"。
CASE_SERVICE_API_KEY=

# 话术库与机构目录（由 scripts/import_resources.py 写入，不要手工编辑）
SCRIPTS_PATH=data/scripts.jsonl
INSTITUTIONS_PATH=data/institutions.jsonl
# 设为 1 时只展示"已审核"的话术 / "已核验"的机构；默认展示草稿但会明确标注。
SCRIPTS_ONLY_REVIEWED=0
DIRECTORY_ONLY_REVIEWED=0

# 回答生成（大模型）
# 生成时间大致与长度成正比；不设上限时一条回答曾要 25-45 秒。
ANSWER_MAX_TOKENS=1400
ANSWER_TIMEOUT=75

# 对话压缩与长期记忆
# 保留最近多少条原文；更早的消息压缩成摘要（摘要和画像都只保存脱敏后的内容）。
CONTEXT_KEEP_RECENT=10
# 设为 0 时不使用大模型提取画像和压缩对话，只用规则（完全离线）。
PROFILE_LLM=1
PROFILE_MODEL=

# 可选案例检索 REST 兜底
# 仅案例检索使用：本地案例目录无命中，且元典 MCP 也未返回结果时才调用。
# 服务需接受 POST JSON {"query":"...", "limit":5}，并返回案例数组或 {"items":[...]}。
# API Key 会以 Authorization: Bearer <key> 发送；未配置 URL 时完全禁用此来源。
# 远端服务会收到用户检索文本，请勿传入身份证号等敏感信息。
CASE_SEARCH_URL=
CASE_SEARCH_API_KEY=
CASE_SEARCH_TIMEOUT=12

# 对话上下文
# 每次请求交给 Agent 的同一对话历史消息数上限；默认值为 24。
MAX_HISTORY_MESSAGES=24
